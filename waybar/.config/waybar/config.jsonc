{
    "reload_style_on_change": true,
    "position": "right",
	"spacing": 10,
	"modules-left": ["sway/workspaces"],
	"modules-right": ["network", "battery", "clock"],
	"clock": {
		"format": "{:%d %b\n%H:%M}"
	},
	"sway/workspaces": {
		"format": "{value}",
		"on-click": "activate",
		"sort-by-number": true
	},
	"network": {
        "format-wifi": "{icon}",
        "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
        "format-ethernet": "󰈀",
        "format-disconnected": "", 
		"interval": 30
	},
	"battery": {
		"format": "{icon}",
		"format-icons": ["󰁻", "󰁽", "󰁿", "󰂁", "󰁹"],
		"interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        }
	}
}
