#!/usr/bin/env bash

connections=$(bluetoothctl devices Connected | wc -l)

full_text="󰂯"
if [ "$connections" -gt 0 ]; then
    full_text="󰂱"
fi

name="bluetooth"
color="fcfcfa"
min_width=17
align="center"
separator="true"
separator_block_widht=25
markup="pango"
urgent="false"

echo "$full_text|$min_width|$align|$separator|$separator_block_widht|$markup|$name|$color|$urgent"
