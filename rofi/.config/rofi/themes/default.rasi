* {
    bg: #2D2A2E;
    fg: #FCFCFA;
    pink: #FF6188;
    orange: #FC9867;
    yellow: #FFD866;
    green: #A9DC76;
    blue: #78DCE8;
    purple: #AB9DF2;
    comment: #727072;
    cursorline: #3E3D41;

    background-color: transparent;
    text-color: @fg;

    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    background-color: @bg;
    spacing: 16px;
    location: center;
    width: 400;
    border: 2px;
    border-color: @blue;
}

mainbox {
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: @blue;
    padding: 10px 16px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt, entry {
    text-transform: Italic;
    text-color: @cursorline;
}

textbox {
    text-color: @blue;
    horizontal-align: 0.5;
}


textbox {
    padding: 10px 24px;
}

listview {
    lines: 10;
    columns: 1;

    fixed-height: false;
    dynamic: false;
    border: 1px 0 0;
    border-color: @comment;
}

element {
    padding: 10px 16px;
    spacing: 16px;
    background-color: transparent;
}

element selected normal, element selected active, element selected urgent {
    background-color: @cursorline;
}

element-text urgent {
    text-color: @pink;
}

element-icon {
    size: 20;
}

element-text {
    vertical-align: 0.5;
}
