#!/usr/bin/env bash

pkg_count=$(cat /tmp/pkgs-updates-count 2>/dev/null || echo -n 0)

if [ "$pkg_count" -eq 0 ]; then
    exit 0
fi

printf '{'
printf '"name": "updates"'
printf ', "full_text": "%s"' "󰚰 <small>$pkg_count</small>"
printf ', "min_width": 30'
printf ', "align": "center"'
printf ', "separator": true'
printf ', "separator_block_width": 25'
printf ', "markup": "pango"'
printf ', "color": "#a9dc76"'
printf ', "urgent": false'
printf ' },\n'

