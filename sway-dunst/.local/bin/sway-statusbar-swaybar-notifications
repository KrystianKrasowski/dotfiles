#!/usr/bin/env bash

unread_count=$(dunstctl history | jq '[.data[][] | select(.urgency.data != "LOW")] | length')

is_paused=$(dunstctl is-paused)

color="fcfcfa"
full_text="󰂚"

if [ "$is_paused" = "true" ]; then
    full_text="󰂛"
    color="78dce8"
elif [ "$unread_count" -eq 0 ]; then
    exit 0
elif [ "$unread_count" -gt 0 ]; then
    full_text="󱅫 <small>"$unread_count"</small>"
    color="ff6188"
fi

name="notif"
min_width=17
align="center"
separator="true"
separator_block_widht=25
markup="pango"
urgent="false"

echo "$full_text|$min_width|$align|$separator|$separator_block_widht|$markup|$name|$color|$urgent"
